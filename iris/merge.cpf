[Startup]
SystemMode=DEMO

[config]
globals=0,0,32768,0,0,0
routines=0
jrnbufs=1024

[Actions]

Execute:Namespace="%SYS",ClassName="Security.Users",MethodName="UnExpireUserPasswords",Arg1="*"
Execute:Namespace="%SYS",ClassName="%SQL.Statement",MethodName="%ExecDirect",Arg1="",Arg2="update security.events set enabled=1"
Execute:Namespace="%SYS",ClassName="%SYSTEM.CSP",MethodName="SetConfig",Arg1="CSPConfigName",Arg2="iris"

CreateResource:Name=%DB_SC_DATA,Description="SC_DATA database"
CreateDatabase:Name=SC_DATA,Directory=/usr/irissys/mgr/SC_DATA,Resource=%DB_SC_DATA
CreateResource:Name=%DB_SC_CODE,Description="SC_CODE database"
CreateDatabase:Name=SC_CODE,Directory=/usr/irissys/mgr/SC_CODE,Resource=%DB_SC_CODE
CreateNamespace:Name=SC,Globals=SC_DATA,Routines=SC_CODE,Interop=1

ModifyService:Name=%Service_CallIn,Enabled=1,AutheEnabled=48